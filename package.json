		"badges:export": "tsx scripts/export-badges.ts",
		"badges:sample": "tsx scripts/render-badge-samples.ts",
		"badges:verify-local": "tsx scripts/verify-badges-local.ts",
		"scanner:wasm": "node scripts/copy-scanner-wasm.mjs",
