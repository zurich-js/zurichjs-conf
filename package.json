		"build": "next build",
		"build:clean": "rm -rf .next && rm -rf node_modules/.cache && next build",
		"start": "next start",
		"lint": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf .next && rm -rf node_modules/.cache",
		"prepare": "husky",
		"email:dev": "email dev --dir ./src/emails --port 3001",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:related": "vitest related --run",
		"db:seed:cfp-first-stage": "scripts/seed-supabase-phase.sh cfp-first-stage",
		"db:seed:cfp-admission": "scripts/seed-supabase-phase.sh cfp-admission",
